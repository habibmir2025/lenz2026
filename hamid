    href="https://wa.me/?text=%D8%B3%D9%84%D8%A7%D9%85%D8%8C%20%D8%A8%D8%B1%D8%A7%DB%8C%20%D8%AF%D8%B1%DB%8C%D8%A7%D9%81%D8%AA%20%D8%A7%D8%B7%D9%84%D8%A7%D8%B9%D8%A7%D8%AA%20%D8%A8%D8%A7%20%D9%81%D8%B1%D9%88%D8%B4%DA%AF%D8%A7%D9%87%20%D8%B9%DB%8C%D9%86%DA%A9%20%D9%88%20%D9%84%D9%86%D8%B2%20%D8%AA%D9%85%D8%A7%D8%B3%20%D9%85%DB%8C%E2%AF%8C%DA%AF%DB%8C%D8%B1%D9%85."
